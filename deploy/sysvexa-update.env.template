# Repositorio y rama de producción. El alias SSH usa la deploy key de solo
# lectura ya configurada para el usuario de construcción.
SYSVEXA_REPOSITORY_URL=git@github-sysvexa:jl-glX/sysvexa-technologies.git
SYSVEXA_UPDATE_BRANCH=main

# Copia aislada, cache y usuario que construye las releases.
SYSVEXA_UPDATER_ROOT=/var/lib/sysvexa-updater
SYSVEXA_SOURCE_DIR=/var/lib/sysvexa-updater/source
SYSVEXA_NPM_CACHE=/var/lib/sysvexa-updater/npm-cache
SYSVEXA_BUILD_USER=replace-with-linux-user

# Release estática compartida por Caddy y la alternativa Nginx.
SYSVEXA_RELEASES_DIR=/var/www/sysvexa/releases
SYSVEXA_CURRENT_LINK=/var/www/sysvexa/current

# Comprobación directa del origen: evita depender del DNS público o de
# Cloudflare para decidir si una release local es saludable.
SYSVEXA_HEALTH_URL=https://sysvexatechnologies.com/
SYSVEXA_HEALTH_RESOLVE=sysvexatechnologies.com:443:127.0.0.1
SYSVEXA_HEALTH_ATTEMPTS=5
SYSVEXA_HEALTH_DELAY_SECONDS=2

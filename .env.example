# La web funciona sin Stripe. La integracion solo se abre cuando todos los
# valores se configuran en el servidor; nunca se exponen al frontend.
STRIPE_CHECKOUT_ENABLED=false
STRIPE_CHECKOUT_MODE=test
STRIPE_RESTRICTED_API_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLIC_ORIGIN=http://localhost:3000
STRIPE_INTEGRATION_IDENTIFIER=
STRIPE_PRICE_MAINTENANCE=
STRIPE_PRICE_COMPUTERS=
STRIPE_PRICE_NETWORKS=
STRIPE_PRICE_SECURITY=

{
  "name": "sysvexa-technologies",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "npm@12.0.2",
  "engines": {
    "node": ">=24.15.0 <25",
    "npm": ">=12.0.2 <13"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "start": "node server/static-server.mjs",
    "test": "vitest run",
    "typecheck": "tsc -b --pretty false",
    "portability:clean": "node scripts/remove-windows-operational-files.mjs",
    "portability:check": "node scripts/check-portability.mjs",
    "deploy:check": "node scripts/check-deployment-assets.mjs",
    "check": "npm run portability:clean && npm run portability:check && npm test && npm run typecheck && npm run build && npm run deploy:check"
  },
  "dependencies": {
    "i18next": "26.4.0",
    "i18next-browser-languagedetector": "8.2.1",
    "lucide-react": "1.34.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-i18next": "17.0.12",
    "stripe": "22.4.0"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.0",
    "jsdom": "30.0.1",
    "typescript": "6.0.3",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
